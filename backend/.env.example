# Copy to .env and adjust. All values have sensible local defaults.

# SQLite DB file (sqlite-vec holds the embeddings). Default is backend/data/citerag.db.
# DATABASE_URL=sqlite:///./data/citerag.db

# Embeddings: local bge-small (default, free) OR openai text-embedding-3-small.
#   bge-small-en-v1.5      -> 384 dims, runs locally, no key
#   text-embedding-3-small -> 1536 dims, needs OPENAI_API_KEY
EMBEDDING_MODEL=bge-small-en-v1.5

# Re-ranker (local cross-encoder), used when RERANK_ENABLED=true.
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval knobs. RERANK_ENABLED defaults on (best recall); set false to skip the
# ~1.1GB cross-encoder and its per-query latency.
RETRIEVAL_TOP_K=5
RERANK_CANDIDATES=20
RERANK_ENABLED=true

# Hybrid retrieval: fuse dense (sqlite-vec) with lexical (SQLite FTS5/BM25) via
# reciprocal rank fusion. On by default and nearly free (FTS5 is built into SQLite);
# set HYBRID_ENABLED=false for dense-only. HYBRID_CANDIDATES = depth pulled from each
# retriever before fusion; RRF_K = the standard RRF damping constant.
HYBRID_ENABLED=true
HYBRID_CANDIDATES=20
RRF_K=60

# Table-aware ingestion (serialize extract_tables() rows into per-row facts). OFF:
# measured on the golden set it lowered recall (0.733 -> 0.667), so it's kept only as
# a recorded experiment. See the README results table.
TABLE_EXTRACTION_ENABLED=false

# LLM answer step for /query (retrieval + eval never need this). Priority order:
# OpenAI key -> Anthropic key -> local model -> extractive fallback.
#
# Free, no API key: run a small instruct model locally on CPU.
LOCAL_LLM_ENABLED=true
LOCAL_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct   # or Qwen/Qwen2.5-1.5B-Instruct for better quality
#
# Or use a hosted API (paid) — set one of these instead:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Re-space words that PDF extraction welded together ("MitsubishiCorporation" ->
# "Mitsubishi Corporation"). FTS5 makes a weld into a single token, so BM25 cannot
# match the entity at all; fixing it lifted recall@5 0.650 -> 0.683 (0.600 -> 0.667
# without the re-ranker). On by default.
SPLIT_RUN_TOGETHER_ENABLED=true

# Dictionary segmentation for all-lowercase welds ("investmentsinequitysecurities" ->
# "investments in equity securities"). Case-boundary splitting can't touch these and
# they were ~10% of all alphabetic tokens across 92% of chunks. Vocabulary is learned
# from the document itself. Lifted recall@5 0.683 -> 0.767. On by default.
WORD_SEGMENTATION_ENABLED=true

# Copy to .env and adjust. All values have sensible local defaults.

# SQLite DB file (sqlite-vec holds the embeddings). Default is backend/data/citerag.db.
# DATABASE_URL=sqlite:///./data/citerag.db

# Embeddings: local bge-small (default, free) OR openai text-embedding-3-small.
#   bge-small-en-v1.5      -> 384 dims, runs locally, no key
#   text-embedding-3-small -> 1536 dims, needs OPENAI_API_KEY
EMBEDDING_MODEL=bge-small-en-v1.5

# Re-ranker (local cross-encoder), used when RERANK_ENABLED=true.
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval knobs. RERANK_ENABLED defaults on (best recall); set false to skip the
# ~1.1GB cross-encoder and its per-query latency.
RETRIEVAL_TOP_K=5
RERANK_CANDIDATES=20
RERANK_ENABLED=true

# Optional — only needed for the LLM answer step in /query.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
